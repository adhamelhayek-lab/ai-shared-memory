# =========================================================
# AI Hub Shared Memory — Environment Configuration
# =========================================================
# SAFE TEMPLATE ONLY
#
# Copy to .env for local development:
#   cp .env.example .env
#
# NEVER put real secrets in GitHub.
# =========================================================

# ---------------------------------------------------------
# Application
# ---------------------------------------------------------

NODE_ENV=development
PORT=3000

# Public API base path
API_PREFIX=/api

# ---------------------------------------------------------
# Authentication
# ---------------------------------------------------------
# Generate a long random value for local use.
# Example:
# MEMORY_API_KEY=<your-random-secret>
#
# NEVER commit the real value.

MEMORY_API_KEY=replace-with-a-long-random-secret

# ---------------------------------------------------------
# Storage
# ---------------------------------------------------------

MEMORY_DATA_DIR=./data
MEMORY_FILE=memories.json

# ---------------------------------------------------------
# Memory limits
# ---------------------------------------------------------

MAX_MEMORY_SIZE=50000
MAX_SEARCH_RESULTS=50

# Maximum request body size
REQUEST_BODY_LIMIT=1mb

# ---------------------------------------------------------
# Security
# ---------------------------------------------------------

# Allow requests only from configured origins.
# For local development, keep this as localhost.
CORS_ORIGIN=http://localhost:3000

# ---------------------------------------------------------
# Logging
# ---------------------------------------------------------

LOG_LEVEL=info

# ---------------------------------------------------------
# Future AI Hub clients
# ---------------------------------------------------------
# These are identifiers, NOT API keys.

HUDА_CLIENT_ID=huda
GOCK_CLIENT_ID=gock
CHALLENGER_CLIENT_ID=challenger
CHATGPT_CLIENT_ID=chatgpt
TRADER_CLIENT_ID=trader

# ---------------------------------------------------------
# Future backup configuration
# ---------------------------------------------------------
# Disabled until encrypted backup is implemented.

BACKUP_ENABLED=false
BACKUP_PROVIDER=none
